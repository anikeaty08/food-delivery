# Server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Telegram
TELEGRAM_BOT_TOKEN=

# OpenAI
OPENAI_API_KEY=
FAST_MODEL=gpt-5.4-mini
DEEP_MODEL=gpt-5.5

# Swiggy MCP OAuth client IDs, issued by Swiggy after access approval
SWIGGY_CLIENT_ID=
SWIGGY_CLIENT_SECRET=

# App storage and dynamic agent config
DATABASE_URL=sqlite:///./data/bot.db
AGENT_CONFIG_PATH=config/agents.yaml
SESSION_SECRET=change-me-in-dev

# Dev shortcut only: lets your own chat use a manually obtained token. Do not use for real users.
DEV_SWIGGY_ACCESS_TOKEN=
